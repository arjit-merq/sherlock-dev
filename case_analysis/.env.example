# Local secrets / machine-specific env for case_analysis runners.
# Copy to case_analysis/.env and fill in. Never commit .env.

# Required for unattended agent runs (preferred over interactive `agent login`):
# Get from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Model for `agent --model` (default in run_case.sh / distill_case.sh is auto)
CASE_ANALYSIS_MODEL=auto

# Create run folder + rendered prompt only; do not call agent
# CASE_ANALYSIS_DRY_RUN=1

# Skip post-FINAL memory distill (LEARNING.md + playbooks)
# CASE_ANALYSIS_SKIP_DISTILL=1

# Slack progress (parent message + thread updates during investigation)
# Channel: https://merqube.slack.com/archives/C0BP45W6WDC
CASE_ANALYSIS_SLACK_CHANNEL_ID=C0BP45W6WDC
# Bot User OAuth Token from api.slack.com/apps (xoxb-…). Invite the bot to the channel.
# Scopes: chat:write, users:read.email (assignee @mentions via users.lookupByEmail)
CASE_ANALYSIS_SLACK_BOT_TOKEN=
# Set to 0 to disable Slack progress even when channel/token are set
# CASE_ANALYSIS_SLACK=0
# Full report as a Slack canvas (renders FINAL.md tables natively). On by default;
# needs the canvases:write bot scope. Set to 0 to keep everything in thread blocks.
# CASE_ANALYSIS_SLACK_CANVAS=0

# Required for automatic Jira polling and live ticket reads.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://merqube.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Local UI (scripts/run_ui.sh)
CASE_ANALYSIS_UI_HOST=127.0.0.1
CASE_ANALYSIS_UI_PORT=8790
# Polling starts with the UI and stops with it. Existing open cases are baseline only.
CASE_ANALYSIS_AUTO_POLL=1
CASE_ANALYSIS_AUTO_POLL_SECONDS=60
CASE_ANALYSIS_AUTO_DELAY_SECONDS=300
# Optional override; defaults to all open Platform Engineering Support cases.
# CASE_ANALYSIS_AUTO_JQL=

# Skip git fetch/pull (SHAs still recorded if sync runs)
# CASE_ANALYSIS_SKIP_SYNC=1
# Skip merq/AWS/agent connectivity checks
# CASE_ANALYSIS_SKIP_PREFLIGHT=1
# Fail the run if merq_creds or agent CLI is missing
# CASE_ANALYSIS_PREFLIGHT_STRICT=1

# Webhook (scripts/webhook_server.py)
CASE_ANALYSIS_WEBHOOK_HOST=127.0.0.1
CASE_ANALYSIS_WEBHOOK_PORT=8787
CASE_ANALYSIS_WEBHOOK_SECRET=change-me-to-a-long-random-string
# CASE_ANALYSIS_WEBHOOK_ALLOW_INSECURE=1
